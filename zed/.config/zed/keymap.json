      "ctrl-w q": null,
      "ctrl-w ctrl-q": null,
      "ctrl-w o": null,
      "ctrl-w ctrl-o": null,
      "ctrl-w n": null,
      "ctrl-w ctrl-n": null,
      "ctrl-w d": null,
      "ctrl-w g d": null,
      "ctrl-w shift-d": null,
      "ctrl-w g shift-d": null,
      "ctrl-w space": null,
      "ctrl-w g space": null
    }
  },
  {
    "unbind": {
      "ctrl-shift-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "ctrl-shift-w up": "workspace::ActivatePaneUp"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w up": "workspace::ActivatePaneUp"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "ctrl-shift-w down": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w down": "workspace::ActivatePaneDown"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "ctrl-shift-w left": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w left": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "ctrl-shift-w right": "workspace::ActivatePaneRight"
    }
  },

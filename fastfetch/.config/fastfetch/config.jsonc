{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch3",
    "color": {
      "1": "#EBBADE",
      "2": "#CBA6F7"
    }
  },
  "display": {
    "separator": " 󰁕 ", // Arrow icon biar lebih smooth dari sekadar │
    "color": {
      "separator": "#F5C2E7" // Pink
    },
    "constants": ["━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"]
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": " {##CBA6F7}  {##89b4fa}Arch Linux"
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator"
    },
    {
      "type": "uptime",
      "key": " 󰅐 ",
      "keyColor": "#a6e3a1" // Green
    },
    {
      "type": "shell",
      "key": "  ",
      "keyColor": "#a6e3a1"
    },
    {
      "type": "terminal",
      "key": "  ",
      "keyColor": "#a6e3a1"
    },
    {
      "type": "terminalfont",
      "key": "  ",
      "keyColor": "#a6e3a1"
    },
    {
      "type": "packages",
      "key": " 󰏖 ",
      "keyColor": "#a6e3a1"
    },
    {
      "type": "localip",
      "key": " 󰩟 ",
      "keyColor": "#f9e2af" // Yellow
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator"
    },
    {
      "type": "display",
      "key": " 󰍹 ",
      "keyColor": "#89b4fa" // Blue
    },
    {
      "type": "cpu",
      "key": "  ",
      "keyColor": "#f38ba8" // Red
    },
    {
      "type": "gpu",
      "key": " 󰢮 ",
      "keyColor": "#f38ba8"
    },
    {
      "type": "memory",
      "key": "  ",
      "keyColor": "#f38ba8"
    },
    {
      "type": "swap",
      "key": " 󰓡 ",
      "keyColor": "#f38ba8"
    },
    {
      "type": "disk",
      "key": " 󰋊 ",
      "keyColor": "#f38ba8"
    },
    {
      "type": "battery",
      "key": "  ",
      "keyColor": "#94e2d5" // Teal
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator"
    },
    "break",
    // {
    //   "type": "colors",
    //   "symbol": "circle" // Jauh lebih clean daripada hardcode unicode manual
    // }
    {
      "type": "custom",
      "format": "       {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}"
    }
  ]
}

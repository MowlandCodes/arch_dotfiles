#!/bin/bash

CURRENT_LOCALE=$(setxkbmap -query | grep 'layout' | awk '{ print $2 }')

toggle_locale() {
    if [[ "${CURRENT_LOCALE}" == "us" ]]; then
        setxkbmap ara
        CURRENT_LOCALE=$(setxkbmap -query | grep 'layout' | awk '{ print $2 }')
        dunstify -r 2593 -a "locale" -t 1000 "Locale" "Switched locale to: <b>${CURRENT_LOCALE^^}</b>"
    elif [[ "${CURRENT_LOCALE}" == "ara" ]]; then
        setxkbmap us
        CURRENT_LOCALE=$(setxkbmap -query | grep 'layout' | awk '{ print $2 }')
        dunstify -r 2593 -a "locale" -t 1000 "Locale" "Switched locale to: <b>${CURRENT_LOCALE^^}</b>"
    fi
}

toggle_locale

#!/usr/bin/env bash

# Check for arguments
if [ $# -ne 2 ]; then
  echo "Pwn solver creator"
  echo "────────────────────────────────────────────────────────"
  echo "Usage: $0 <file_name> <destination_path>"
fi

echo "Creating file $2/$1.py"
cp "$HOME/.local/bin/pwn_solver.py" "$2/$1.py"

echo "Done"
